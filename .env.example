# rx.bd Mobile — environment template. Copy to .env (gitignored) for local dev.
# Production/staging values are injected via EAS secrets, never committed.

# Build flavor: patient-public | staff-internal
RXBD_FLAVOR=patient-public

# Env tier: development | staging | production
RXBD_ENV=development

# rx.bd API base URL (the backend this client consumes)
RXBD_API_BASE_URL=http://localhost:3000

# Sentry DSN (PHI-scrubbed). Leave blank to disable in local dev.
RXBD_SENTRY_DSN=
