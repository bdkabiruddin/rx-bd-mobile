{
  "name": "rxbd-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "rx.bd enterprise healthcare mobile app — React Native + Expo (Android phone/tablet + iPad)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "api:generate": "openapi-typescript ../src/app/api/v1/openapi.yaml -o src/api/generated/schema.ts",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "e2e": "maestro test e2e/"
  },
  "//dependencyApproval": "This manifest IS the dependency list for owner approval (rx.bd rule: no new deps without sign-off). NOTHING is installed yet. After approval, run `npx expo install` to align native versions to the chosen Expo SDK, then `pnpm|npm install` the JS-only deps. Versions below target Expo SDK 53 / RN 0.79; `expo install` will reconcile exact pins.",
  "dependencies": {
    "expo": "~53.0.0",
    "expo-router": "~5.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-notifications": "~0.30.0",
    "expo-device": "~7.0.0",
    "expo-application": "~6.0.0",
    "expo-localization": "~16.0.0",
    "expo-crypto": "~14.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-screen-capture": "~7.0.0",
    "expo-build-properties": "~0.13.0",
    "react": "19.0.0",
    "react-native": "0.79.0",
    "react-native-safe-area-context": "~5.0.0",
    "react-native-screens": "~4.5.0",
    "@tanstack/react-query": "^5.59.0",
    "@react-native-community/netinfo": "^11.4.1",
    "zustand": "^5.0.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8",
    "@sentry/react-native": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.0",
    "typescript": "~5.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "@testing-library/react-native": "^12.7.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~8.0.0",
    "openapi-typescript": "^7.4.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
